{
  "name": "ai-workbench",
  "version": "1.0.0",
  "description": "本地程序悬浮台：把常用的本地 AI 工具收在一条悬浮条上",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win --x64",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.aiworkbench.app",
    "productName": "AI-Workbench",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-browser.js",
      "renderer/**/*",
      "modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "winmgr.py",
        "to": "winmgr.py"
      },
      {
        "from": "assets/tray.ico",
        "to": "assets/tray.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/tray.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI 悬浮台",
      "artifactName": "AI-Workbench-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "electronLanguages": [
      "zh-CN",
      "zh-TW",
      "en-US",
      "en-GB"
    ],
    "extraFiles": [],
    "compression": "maximum"
  },
  "author": {
    "name": "AI Workbench contributors"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/<owner>/ai-workbench"
  },
  "keywords": [
    "electron",
    "launcher",
    "tray",
    "productivity",
    "windows"
  ]
}